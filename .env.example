# ===========================
# Neo4j
# ===========================
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j
NEO4J_DATABASE=neo4j

# ===========================
# PostgreSQL
# ===========================
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=chatbot
PG_USER=postgres
PG_PASSWORD=postgres

# ===========================
# vLLM Generation (port 8000)
# ===========================
VLLM_GEN__BASE_URL=http://localhost:8000/v1
VLLM_GEN__API_KEY=EMPTY
VLLM_GEN__MODEL_NAME=Qwen/Qwen3-8B-GGUF:Q4_K_M
VLLM_GEN__MAX_TOKENS=1024
VLLM_GEN__TEMPERATURE=0.2
VLLM_GEN__ENABLE_PREFIX_CACHING=true
VLLM_GEN__ENABLE_CHUNKED_PREFILL=true
VLLM_GEN__GPU_MEMORY_UTILIZATION=0.65
VLLM_GEN__BLOCK_SIZE=16
VLLM_GEN__MAX_MODEL_LEN=8192
VLLM_GEN__MAX_NUM_SEQS=32

# ===========================
# vLLM Embedding (port 8001)
# ===========================
VLLM_EMBED__BASE_URL=http://localhost:8001/v1
VLLM_EMBED__API_KEY=EMPTY
VLLM_EMBED__MODEL_NAME=BAAI/bge-m3
VLLM_EMBED__GPU_MEMORY_UTILIZATION=0.20
VLLM_EMBED__CACHE_SIZE=4096

# Embedding dimension (Neo4j vector index must match)
EMBED__MODEL_NAME=BAAI/bge-m3
EMBED__DIMENSION=1024
EMBED__NORMALIZE=true

# Fallback: sentence-transformers in-process when vLLM embed is unstable
EMBED__FALLBACK_PROVIDER=sentence_transformers

# ===========================
# Service
# ===========================
APP_ENV=EXAMPLE
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8080

# Ontology / ingest versioning
ONTOLOGY_PROMPT_VERSION=1.0
ONTOLOGY_MODEL_NAME=Qwen/Qwen3-8B-GGUF:Q4_K_M

# Vocab auto-promotion
VOCAB_PROMOTE_MIN_COUNT=50
VOCAB_PROMOTE_MIN_DAYS=7
VOCAB_ALIAS_COS_SIM=0.90
VOCAB_PROMOTE_MAX_COS_SIM=0.85

# Bandit
BANDIT_BASELINE_MIN_SHARE=0.05
BANDIT_MAX_WEIGHT_DELTA=0.20

# Judge / drift
JUDGE_DAILY_SAMPLE_SIZE=100
DRIFT_KL_THRESHOLD=0.15
EVAL_SLACK_WEBHOOK_URL=
