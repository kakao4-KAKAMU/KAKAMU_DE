# docker compose 전용 환경변수 예시
# 사용: cp docker-compose.env.example docker-compose.env

# --- Docker network (컨테이너 간 통신 — OS 무관, 서비스명 DNS 사용) ---
# NEO4J_URI / PG_HOST 는 docker-compose.yml 에서 서비스명으로 고정됩니다.
# 호스트에서 접속 시에만 아래 TEST_PORT 를 조정하세요 (포트 충돌 방지).
# NEO4J_TEST_PORT=7474
# NEO4J_BOLT_TEST_PORT=7687
# PG_TEST_PORT=5432

# --- Neo4j (서비스명 neo4j) ---
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j
NEO4J_DATABASE=neo4j

# --- PostgreSQL (서비스명 postgres) ---
PG_HOST=postgres
PG_PORT=5432
PG_DATABASE=chatbot
PG_USER=postgres
PG_PASSWORD=postgres

# --- Docker 이미지 테스트 (docker compose up --abort-on-container-exit --exit-code-from test-all) ---
# docker build -f docker-image/base.Dockerfile -t movie-recommend-system-base:latest .
# DOCKER_BASE_IMAGE=movie-recommend-system-base:latest
# IMAGE_BOOTSTRAP=myuser/movie-recommend-system-bootstrap:1.42
# IMAGE_API=myuser/movie-recommend-system-api:1.42
# IMAGE_INGEST=myuser/movie-recommend-system-ingest-worker:1.42

# --- Embedding (테스트: mock ingest, vLLM 불필요) ---
EMBED_FALLBACK_PROVIDER=none

# --- App ---
APP_ENV=local

ONTOLOGY_PROMPT_VERSION=1.0
ONTOLOGY_MODEL_NAME=Qwen/Qwen3-8B-GGUF:Q4_K_M

VOCAB_PROMOTE_MIN_COUNT=50
VOCAB_PROMOTE_MIN_DAYS=7
VOCAB_ALIAS_COS_SIM=0.90
VOCAB_PROMOTE_MAX_COS_SIM=0.85

BANDIT_BASELINE_MIN_SHARE=0.05

JUDGE_DAILY_SAMPLE_SIZE=100
DRIFT_KL_THRESHOLD=0.15
EVAL_SLACK_WEBHOOK_URL=
